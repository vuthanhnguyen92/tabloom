NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:4173
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key
VITE_TABLOOM_WEB_URL=http://localhost:4173

# Remote MCP service and OAuth readiness probe
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
TABLOOM_MCP_RESOURCE_URL=https://your-mcp-project.vercel.app
TABLOOM_OAUTH_ISSUER_URL=https://your-mcp-project.vercel.app
TABLOOM_OAUTH_ENABLED=false
# Disabled mode uses empty arrays. Enabled production requires real key rings
# stored only in Vercel; never put private key material in an env file.
TABLOOM_OAUTH_SIGNING_KEYS=[]
TABLOOM_OAUTH_ENCRYPTION_KEYS=[]
TABLOOM_MCP_OAUTH_TIMEOUT_MS=600000

# Optional headed bookmark-sync acceptance environment
TABLOOM_E2E_WEB_URL=http://localhost:4173
TABLOOM_E2E_USER_EMAIL=
TABLOOM_E2E_USER_PASSWORD=
TABLOOM_E2E_LIVE=0

# Explicit, headed, human-authenticated MCP facade acceptance (off by default)
TABLOOM_E2E_MCP_LIVE=0
TABLOOM_E2E_MCP_RESOURCE_URL=https://tabloom-mcp.vercel.app
TABLOOM_E2E_MCP_FIXTURE_PATH=/absolute/path/outside/repository/mcp-live-fixture.json
TABLOOM_E2E_MCP_SIGNING_KEY_PATH=/absolute/path/outside/repository/mcp-live-active-signing-key.json
