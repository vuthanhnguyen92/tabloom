{
  "manifest_version": 3,
  "key": "",
  "name": "Tabloom — Calm tab workspace",
  "description": "Capture open tabs into organized, synchronized spaces.",
  "version": "0.7.0",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["tabs", "storage", "identity"],
  "optional_permissions": ["tabGroups", "bookmarks"],
  "host_permissions": ["https://*.supabase.co/*"],
  "chrome_url_overrides": { "newtab": "index.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://*.supabase.co"
  }
}
